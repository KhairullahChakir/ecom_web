import numpy as np # linear algebra
import pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)
import gc

# Input data files are available in the read-only "../input/" directory
# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory

import os
for dirname, _, filenames in os.walk('/kaggle/input'):
    for filename in filenames:
        print(os.path.join(dirname, filename))

# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using "Save & Run All" 
# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session








# Peeking at the data to establish a baseline
preview = pd.read_csv('/kaggle/input/ecommerce-behavior-data-from-multi-category-store/2019-Oct.csv', nrows=1000)
preview.head(10)








preview.nunique()





preview.dtypes


# Checking max values for int64 columns
print(preview[['product_id', 'category_id', 'user_id']].max())





# Memory-efficient dtypes
dtypes = {
    'event_time': 'str',
    'event_type': 'category',
    'product_id': 'int32',
    'category_id': 'int64',
    'category_code': 'category',
    'brand': 'category',
    'price': 'float32',
    'user_id': 'int32',
    'user_session': 'category'
}


# Loading CSVs with optimized data types
oct_df = pd.read_csv('/kaggle/input/ecommerce-behavior-data-from-multi-category-store/2019-Oct.csv', dtype=dtypes)
nov_df = pd.read_csv('/kaggle/input/ecommerce-behavior-data-from-multi-category-store/2019-Nov.csv', dtype=dtypes)


# Merging two files into one
df = pd.concat([oct_df, nov_df], ignore_index=True)





# Checking data types of the concatenated file
df.dtypes


# Casting data types again
df = df.astype(dtypes)


# Checking dtypes again
df.dtypes








# Converting heavy user_session string hashes to integer category codes to drastically reduce RAM
df['user_session'] = df['user_session'].cat.codes


# Converting event_time into a proper datetime64
df['event_time'] = pd.to_datetime(df['event_time'].str.replace(' UTC', ''), format='ISO8601')


# Removing timezone localization
df['event_time'] = df['event_time'].dt.tz_localize(None)


del oct_df, nov_df


gc.collect()








# Quick check once loaded
print("Full dataset shape:", df.shape)





# Categorical columns
df.describe(include='category')





#Event type distribution
df['event_type'].value_counts()





# Category_code breakdown
df['category_code'].value_counts()





# Brand brakedown
df['brand'].value_counts()





# Quick view on price
df['price'].describe()








# Missing values
df.isnull().sum()


print("Percentage of missing values per column")
df.isnull().mean().round(4) * 100





for col in ['category_code', 'brand']:
    if 'Unknown' not in df[col].cat.categories:
        df.loc[:, col] = df[col].cat.add_categories('Unknown')
    df.loc[df[col].isna(), col] = 'Unknown'


print(df[['category_code', 'brand']].isna().sum())


#Zero-price
total_rows = len(df)
zero_rows = df[df['price'] == 0]
zero_count = len(zero_rows)
zero_pct = round((zero_count / total_rows) * 100, 4)
print(f'Zero price rows: {zero_count} ({zero_pct}% of dataset)')


# Zero-price distribution by event type
print("\nZero-price rows by event_type:")
print(zero_rows['event_type'].value_counts())


# Cart events with zero-price items
df.loc[:, 'is_zero_price_cart'] = (df['price'] == 0) & (df['event_type'] == 'cart')
df[df['is_zero_price_cart']]


# Products with zero price
zero_products = zero_rows['product_id'].unique()

# Check how many of those products also have non-zero prices
overlap_products = df[(df['product_id'].isin(zero_products)) & (df['price'] > 0)]['product_id'].nunique()

print(f"\nProducts with zero price: {len(zero_products)}")
print(f"Products with both zero and non-zero prices: {overlap_products}")


# Few products that appear with both zero and non-zero prices
print("\nSample products with both zero and non-zero prices:")
df[df['product_id'].isin(zero_products)].groupby('product_id')['price'].describe()





# Drop zero-price rows entirely
df = df[df['price'] > 0]

# Remove flag column
df = df.drop(columns=['is_zero_price_cart'])


# Duplicate rows
duplicated_rows = df.duplicated().sum()
print(f"Total rows: {len(df)}")
print(f"Number of duplicate rows: {df.duplicated().sum()}")
print(f"Percentage of duplicated rows: {(duplicated_rows / len(df)) * 100:.2}%")





df = df.drop_duplicates()
print(f"Remaining duplicates: {df.duplicated().sum()}")


# See how many rows have no session
null_sessions = (df['user_session'] == -1).sum()
print(f"Rows with no session ID: {null_sessions}")


# Remove null sessions
df = df[df['user_session'] != -1]


# Remove unused categories
for col in ['category_code', 'brand', 'event_type']:
    df[col] = df[col].cat.remove_unused_categories()


gc.collect()





import matplotlib.pyplot as plt
import pandas as pd 
import numpy as np
import gc


# 1. Resample by hour to check for activity gaps using 'event_time' column
hourly_activity = df.set_index('event_time').resample('h').size()


# 2. Visualize the timeline
plt.figure(figsize=(16, 6))
hourly_activity.plot(color='#2ecc71', linewidth=1.5)
plt.title('Hourly Event Frequency: Oct - Nov 2019', fontsize=16, fontweight='bold')
plt.ylabel('Number of Events', fontsize=12)
plt.xlabel('Date', fontsize=12)
plt.grid(axis='y', linestyle='--', alpha=0.3)
plt.axvline(pd.Timestamp('2019-11-01'), color='red', linestyle='--', alpha=0.5, label='Month Switch')
plt.legend()
plt.show()


# 3. Identify specific 'Zero' hours (so called blackouts)
gaps = hourly_activity[hourly_activity == 0]
if not gaps.empty:
    print(f"Warning: Found {len(gaps)} hours with zero data")
    print(gaps.index.tolist())
else:
    print("Timeline is solid, no missing hours find in 110M rows")





gc.collect()





# 1. Get the statistical overview of the price column (we'll use 'float' formatting to avoid scientific notation)
stats = df['price'].describe()
print("\n--- Price Statistics ---")
print(stats.apply(lambda x: f"{x:,.2f}"))


# 2. Identify the 'Luxury' outliers (checking top 10 most expensive items if they're realistic)
print("\n--- Top 10 Most Expensive Events ---")
top_prices = df.nlargest(10, 'price')[['event_time', 'brand', 'category_code', 'price']]
print(top_prices)


# 3. Check for suspiciously low prices bigger than zero (sometimes products are listed at $0.01 as a placeholder)
low_prices = df[df['price'] <= 0.1 ].shape[0]
print(f"\n Items priced or equal to $0.10: {low_prices}")





gc.collect()





# 1. Count events per user
user_activity = df.groupby('user_id').size().sort_values(ascending=False)

print("\n--- Top 10 most active users ---")
print(user_activity.head(10))


# 2. Visualize the distribution (log scale because of the massive range )
plt.figure(figsize=(10,5))
plt.hist(user_activity, bins=100, log=True, color='purple', alpha=0.7)
plt.title('Distribution of User Activity (Log Scale)')
plt.xlabel('Number of Events per User')
plt.ylabel('Number of Users (Log Count)')
plt.show()


# 3. Flag potential bots. A typical human might view 50-200 items. Anyone with >1000 events in two months is likely a scraperor a bot.
bot_treshold = 1000
bots = user_activity[user_activity > bot_treshold]

print(f"\nPotential bots identified (> {bot_treshold} events): {len(bots)}")
print(f"Percentage of users flagged: {(len(bots) / df['user_id'].nunique()) * 100:.4f}%")


# 4. Removing the bots
total_rows = len(df)
df = df[~df['user_id'].isin(bots.index)]

print(f"Number of bots (User IDs) removed: {len(bots):,}")
print(f"Number or rows removed: {total_rows - len(df):,}")
print(f"Final Human-Only row count: {len(df):,}")











# Checking data types, again
print(df.dtypes)


# Checking memory footprint once again
print(df.memory_usage(deep=True) / 1024**2)



# Verifying file's time span integrity
print(f"Date Range: {df['event_time'].min()} to {df['event_time'].max()}")





# Reset the index to remove 'holes' and save a tiny bit of RAM/Storage
df.reset_index(drop=True, inplace=True)


df.info()


# Save to Parquet using 'zstd' compression (best balance of speed and size)
# index=False tells Parquet NOT to save the index as a separate column
df.to_parquet('ecommerce_final.parquet', index=False, compression='zstd')


# Filter back to individual months
oct_only = df[df['event_time'] < '2019-11-01']
nov_only = df[df['event_time'] >= '2019-11-01']


# Saving them as individual Parquet files
oct_only.to_parquet('oct_df_clean.parquet', index=False, compression='zstd')
nov_only.to_parquet('nov_df_clean.parquet', index=False, compression='zstd')





